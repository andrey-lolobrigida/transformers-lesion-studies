# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Environments ---
.venv/
venv/
env/
.python-version
.env
.envrc

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# --- Editors ---
.idea/
.vscode/
*.swp
.DS_Store

# --- Notebooks ---
# Notebooks are for looking at things once (CLAUDE.md). Committing one is fine;
# committing its checkpoint directory is not.
.ipynb_checkpoints/

# --- Model weights and caches ---
# Never commit weights. Pin the HuggingFace revision hash in the results
# artifact instead (docs/06-environment.md) — that is the reproducible record.
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.gguf
models/
checkpoints/
.cache/
.hf_cache/
huggingface/
wandb/

# --- Scratch ---
# notes/ IS tracked — it is part of the record. This is for genuine throwaway.
scratch/
tmp/
*.log

# --- Deliberately NOT ignored ---
# results/   — every experiment artifact is committed. "Results are files, not
#              memories." If an artifact is too large to commit, that is a
#              signal to summarise it, not to ignore it.
# batteries/ — datasets are generated by committed scripts with a seed, so the
#              generator is the source of truth. Revisit this line if a
#              generated battery ever grows past a few MB.
# notes/     — reading notes are the R-phase deliverable.
# --- Design specs (local only) ---
# Brainstorming/design documents from the superpowers workflow. Deliberately
# untracked: the *decision* belongs in docs/04-decisions.md at a few lines, and
# a full design doc in the repo would bloat the one document that has to stay
# short enough to reread. The spec is working material, not the record.
.superpowers/

# --- Local copies of papers ---
# Source PDFs/HTML for the wiki. Not ours to redistribute, and the canonical
# pointer is the URL recorded in the source card (wiki/sources/).
papers/
